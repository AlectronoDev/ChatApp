# Copy this file to .env and fill in values before running locally.
# .env is git-ignored and must never be committed.

# ─── Required (API) ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://chatapp:chatapp@localhost:5432/chatapp

# ─── sqlx (IDE / offline builds) ───────────────────────────────────────────────
# Tell sqlx::query! to use the .sqlx cache instead of a live DB connection.
SQLX_OFFLINE=true

# ─── Logging ──────────────────────────────────────────────────────────────────
# Rust log filter — e.g. "info", "debug", "api=debug,sqlx=warn"
RUST_LOG=info
# API log line format: "text" (human-readable) or "json" (production / SIEM)
LOG_FORMAT=text

# ─── API behavior (all optional — defaults match ops.md) ─────────────────────
# Session token lifetime in days (default: 30)
# SESSION_DURATION_DAYS=30

# Per-user rate limits (see docs/ops.md)
# KEY_BUNDLE_RATE_LIMIT_RPS=2
# AUTH_RATE_LIMIT_RPS=1

# Set true in production (adds HSTS; TLS must be terminated at the proxy).
# Leave false or unset for plain HTTP local dev.
REQUIRE_HTTPS=false
